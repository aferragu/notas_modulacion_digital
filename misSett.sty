\newcommand{\specleft}[1]{%
\draw [domain=#1-0.95:#1-0.4-0.001, samples=50] plot (\x,{sin(pi*(2*(\x-#1)-0.8) r)/(pi*(2*(\x-#1)-0.8))+sin(pi*(2*(\x-#1)+0.8) r)/(pi*(2*(\x-#1)+0.8))});
\draw [domain=#1-0.4+0.001:#1, samples=50] plot (\x,{sin(pi*(2*(\x-#1)-0.8) r)/(pi*(2*(\x-#1)-0.8))+sin(pi*(2*(\x-#1)+0.8) r)/(pi*(2*(\x-#1)+0.8))});}

\newcommand{\specright}[1]{%
\draw [domain=#1:#1+0.4-0.001, samples=50] plot (\x,{sin(pi*(2*(\x-#1)-0.8) r)/(pi*(2*(\x-#1)-0.8))+sin(pi*(2*(\x-#1)+0.8) r)/(pi*(2*(\x-#1)+0.8))});
\draw [domain=#1+0.4+0.001:#1+0.95, samples=50] plot (\x,{sin(pi*(2*(\x-#1)-0.8) r)/(pi*(2*(\x-#1)-0.8))+sin(pi*(2*(\x-#1)+0.8) r)/(pi*(2*(\x-#1)+0.8))});}

\newcommand{\specleftf}[1]{%
\draw [domain=#1-0.95:#1-0.4-0.001, samples=50] plot (\x,{sin(pi*(2*(\x-#1)-0.8) r)/(pi*(2*(\x-#1)-0.8))+sin(pi*(2*(\x-#1)+0.8) r)/(pi*(2*(\x-#1)+0.8))});
\draw [domain=#1-0.4+0.001:#1, samples=50] plot (\x,{sin(pi*(2*(\x-#1)-0.8) r)/(pi*(2*(\x-#1)-0.8))+sin(pi*(2*(\x-#1)+0.8) r)/(pi*(2*(\x-#1)+0.8))}) -- (#1,0);}

\newcommand{\specrightf}[1]{%
\draw [domain=#1:#1+0.4-0.001, samples=50] (#1,0) -- plot (\x,{sin(pi*(2*(\x-#1)-0.8) r)/(pi*(2*(\x-#1)-0.8))+sin(pi*(2*(\x-#1)+0.8) r)/(pi*(2*(\x-#1)+0.8))});
\draw [domain=#1+0.4+0.001:#1+0.95, samples=50] plot (\x,{sin(pi*(2*(\x-#1)-0.8) r)/(pi*(2*(\x-#1)-0.8))+sin(pi*(2*(\x-#1)+0.8) r)/(pi*(2*(\x-#1)+0.8))});}


\newcommand{\specfull}[1]{\specleft{#1}\specright{#1}}

